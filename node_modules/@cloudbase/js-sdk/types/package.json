{
  "name": "@cloudbase/types",
  "version": "3.9.1",
  "description": "cloudbase javascript sdk types",
  "main": "dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.d.ts"
    },
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "result.d.ts",
    "error.d.ts",
    "cache.d.ts",
    "events.d.ts",
    "request.d.ts",
    "auth.d.ts",
    "component.d.ts",
    "functions.d.ts",
    "cloudrun.d.ts",
    "container.d.ts",
    "analytics.d.ts",
    "storage.d.ts",
    "realtime.d.ts",
    "database.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TencentCloudBase/cloudbase-js-sdk"
  },
  "keywords": [
    "cloudbase",
    "Cloudbase",
    "CloudBase",
    "tcb",
    "TCB",
    "serverless",
    "Serverless",
    "javascript",
    "typescript"
  ],
  "author": "",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cloudbase/adapter-interface": "~0.7.1"
  },
  "gitHead": "859557576897d4778857c12fb8d7fe8ca1f3a052"
}
